# ─────────────────────────────────────────────────────────────────────────────
# Eskgo · variáveis de ambiente (MODELO — este arquivo vai para o GitHub)
#
#   1. Copie para .env  →  cp .env.example .env
#   2. Preencha os valores. O .env NUNCA vai para o Git (está no .gitignore).
#   3. Na Vercel, cadastre as mesmas chaves em Settings → Environment Variables.
#
# REGRA DE OURO
#   VITE_*  → vai para o navegador. É PÚBLICO. Nunca coloque segredo aqui.
#   sem VITE_ → só o servidor (Vercel Functions em /api) enxerga.
#   O vite.config.ts bloqueia o build se um segredo aparecer com prefixo VITE_.
# ─────────────────────────────────────────────────────────────────────────────


# ── App (público) ────────────────────────────────────────────────────────────
VITE_APP_NAME=Eskgo
VITE_APP_URL=http://localhost:5173


# ── Supabase (público por design; protegido por RLS) ─────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica


# ── IA do estágio 2 (Plus) ───────────────────────────────────────────────────
# mock = roda no próprio front, sem rede (padrão, usado hoje)
# api  = chama as Vercel Functions em /api, que falam com a OpenAI
VITE_AI_MODE=mock
VITE_API_BASE_URL=/api


# ═════════════════════════════════════════════════════════════════════════════
# SOMENTE SERVIDOR — usadas pelas Functions em /api (Vercel). Nunca no front.
# ═════════════════════════════════════════════════════════════════════════════

# OpenAI → https://platform.openai.com/api-keys
# Usada para: leitura de fatura (PDF/foto), insight em Metas e chat do Assistente.
# Exemplo de uso: docs/integracao/openai.md
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Supabase service role (ignora RLS — só para tarefas de servidor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta
